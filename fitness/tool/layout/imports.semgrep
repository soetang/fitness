# These patterns collect import facts, not Fitness policy decisions.
rules:
  - id: import
    languages: [python]
    severity: INFO
    message: $MODULE
    patterns:
      - pattern: import $MODULE
      - pattern-not: from $FROM import $SYMBOL
  - id: from-import
    languages: [python]
    severity: INFO
    message: $MODULE|$SYMBOL
    pattern: from $MODULE import $SYMBOL
  - id: dynamic-import
    languages: [python]
    severity: INFO
    message: $MODULE
    patterns:
      - pattern-either:
          - pattern: importlib.import_module("$MODULE", ...)
          - pattern: __import__("$MODULE", ...)
          - pattern: importlib.import_module(name="$MODULE", ...)
          - pattern: __import__(name="$MODULE", ...)
      - metavariable-regex:
          metavariable: $MODULE
          regex: ^[^.]
  - id: relative-dynamic-import
    languages: [python]
    severity: INFO
    message: $PACKAGE|$MODULE
    pattern-either:
      - pattern: importlib.import_module("$MODULE", "$PACKAGE")
      - pattern: importlib.import_module("$MODULE", package="$PACKAGE")
      - pattern: importlib.import_module(name="$MODULE", package="$PACKAGE")
  - id: feature-access
    languages: [python]
    severity: INFO
    message: fitness.features.$FEATURE.$MODULE
    patterns:
      - pattern: $ROOT.features.$FEATURE.$MODULE
      - pattern-inside: |
          import fitness
          ...
      - metavariable-regex:
          metavariable: $ROOT
          regex: ^fitness$
      - pattern-not-inside: |
          def $FUNC(..., $ROOT, ...):
              ...
      - pattern-not-inside: |
          $ROOT = ...
          ...
  - id: feature-package-access
    languages: [python]
    severity: INFO
    message: fitness.features.$FEATURE
    patterns:
      - pattern: $ROOT.features.$FEATURE
      - pattern-inside: |
          import fitness
          ...
      - metavariable-regex:
          metavariable: $ROOT
          regex: ^fitness$
      - pattern-not-inside: |
          def $FUNC(..., $ROOT, ...):
              ...
      - pattern-not-inside: |
          $ROOT = ...
          ...
